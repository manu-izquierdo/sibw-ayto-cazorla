{% extends "base.html.twig" %}

{% block tituloPagina %} <title>Iniciar Sesión – Ayto Cazorla</title> {% endblock %}

{% block formatoCss %}
    {{ parent() }} 
    <link rel="stylesheet" href="css/auth.css">
{% endblock %}

{% block cuerpo %}

    <main class="main-formulario-auth">
        <div class="contenedor-auth">
            <h2>Iniciar Sesión</h2>

            {% if error %}
                <p class="auth-error">{{ error }}</p>
            {% endif %}

            <form action="/login" method="POST" class="form-auth">

                <label for="email">Correo electrónico:</label>
                <input type="email" id="email" name="email" class="input-estilo" required autofocus>

                <label for="password">Contraseña:</label>
                <input type="password" id="password" name="password" class="input-estilo" required>

                <button type="submit" class="btn-auth">Entrar</button>
            </form>

            <p class="auth-enlace">¿No tienes cuenta? <a href="/registro">Regístrate aquí</a></p>
        </div>
    </main>

{% endblock %}
