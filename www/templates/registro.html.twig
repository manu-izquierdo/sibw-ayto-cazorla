{% extends "base.html.twig" %}

{% block tituloPagina %} <title>Registro – Ayto Cazorla</title> {% endblock %}

{% block formatoCss %}
    {{ parent() }}
    <link rel="stylesheet" href="css/auth.css">
{% endblock %}

{% block cuerpo %}

    <main class="main-formulario-auth">
        <div class="contenedor-auth">
            <h2>Crear cuenta</h2>

            {% if error %}
                <p class="auth-error">{{ error }}</p>
            {% endif %}

            <form action="/registro" method="POST" class="form-auth">

                <label for="nombre">Nombre:</label>
                <input type="text" id="nombre" name="nombre" class="input-estilo" required autofocus>

                <label for="email">Correo electrónico:</label>
                <input type="email" id="email" name="email" class="input-estilo" required>

                <label for="password">Contraseña:</label>
                <input type="password" id="password" name="password" class="input-estilo" required>

                <label for="password2">Repetir contraseña:</label>
                <input type="password" id="password2" name="password2" class="input-estilo" required>

                <button type="submit" class="btn-auth">Registrarse</button>
            </form>

            <p class="auth-enlace">¿Ya tienes cuenta? <a href="/login">Inicia sesión</a></p>
        </div>
    </main>

{% endblock %}
