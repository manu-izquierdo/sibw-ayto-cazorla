{% extends "base.html.twig" %}

{% block tituloPagina %} <title>Gestión de Noticias – Ayto Cazorla</title> {% endblock %}

{% block formatoCss %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
{% endblock %}

{% block cuerpo %}
<main class="main-gestion">

    <div class="gestion-cabecera">
        <h2>Gestión de noticias</h2>
        <div class="gestion-cabecera-botones">
            <a href="/hashtags" class="btn-limpiar">
                <i class="fa-solid fa-hashtag"></i> Gestionar hashtags
            </a>
            <a href="/noticias?accion=nueva" class="btn-nueva-noticia">
                <i class="fa-solid fa-plus"></i> Nueva noticia
            </a>
        </div>
    </div>

    {# ── P5: id al formulario para interceptarlo con JS ── #}
    <form id="form-busqueda-noticias" action="/noticias" method="GET"
          class="form-busqueda form-busqueda-noticias">
        <input type="text" id="buscar_titulo" name="buscar_titulo"
               class="input-estilo input-busqueda"
               placeholder="Buscar por título..."
               value="{{ busqueda_titulo }}">
        <input type="text" id="buscar_desc" name="buscar_desc"
               class="input-estilo input-busqueda"
               placeholder="Buscar por descripción..."
               value="{{ busqueda_desc }}">
        <select id="buscar_hashtag" name="buscar_hashtag"
                class="input-estilo select-hashtag-buscar">
            <option value="">— Todos los hashtags —</option>
            {% for tag in todos_hashtags %}
                <option value="{{ tag.nombre }}"
                    {{ busqueda_hashtag == tag.nombre ? 'selected' : '' }}>
                    #{{ tag.nombre }}
                </option>
            {% endfor %}
        </select>
        <button type="submit" class="btn-buscar">
            <i class="fa-solid fa-magnifying-glass"></i> Buscar
        </button>
        {# Siempre visible: JS previene el default y hace AJAX; si no hay JS navega normalmente #}
        <a href="/noticias" class="btn-limpiar btn-limpiar-noticias">Limpiar</a>
    </form>

    {% if noticias is empty %}
        <p class="gestion-vacio">No se encontraron noticias.</p>
    {% else %}
        <table class="tabla-gestion">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Imagen</th>
                    <th>Título</th>
                    <th>Tipo</th>
                    <th>Concejalía</th>
                    <th>Fecha</th>
                    <th>Publicado</th>  {# ← NUEVA COLUMNA #}
                    <th>Acciones</th>
                </tr>
            </thead>
            {# ← id para que JS pueda reemplazar las filas tras búsqueda AJAX #}
            <tbody id="tbody-noticias">
                {% for n in noticias %}
                <tr>
                    <td>{{ n.id }}</td>
                    <td>
                        {% if n.ruta %}
                            <img src="{{ n.ruta }}" alt="{{ n.titulo }}" class="thumb-noticia">
                        {% else %}
                            <span class="sin-imagen">Sin imagen</span>
                        {% endif %}
                    </td>
                    <td>
                        <a href="/noticia/{{ n.id }}" class="enlace-noticia">{{ n.titulo }}</a>
                    </td>
                    <td>{{ n.tipo }}</td>
                    <td>{{ n.concejalia }}</td>
                    <td>{{ n.fecha|date("d/m/Y") }}</td>
                    {# ← P5: checkbox que dispara AJAX al cambiar #}
                    <td>
                        <input type="checkbox"
                               class="checkbox-publicado"
                               data-id="{{ n.id }}"
                               {{ n.publicado ? 'checked' : '' }}>
                    </td>
                    <td class="td-acciones">
                        <a href="/noticias?accion=form-editar&id={{ n.id }}"
                           class="btn-icono btn-editar-toggle" title="Editar noticia">
                            <i class="fa-solid fa-pen"></i>
                        </a>
                        <form action="/noticias" method="POST"
                              style="display:inline"
                              class="form-confirmar"
                              data-mensaje="¿Borrar la noticia «{{ n.titulo }}»? Se eliminarán también sus imágenes y comentarios.">
                            <input type="hidden" name="accion"     value="borrar">
                            <input type="hidden" name="id_noticia" value="{{ n.id }}">
                            <button type="submit" class="btn-icono btn-borrar" title="Borrar noticia">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}

</main>
{% endblock %}