{% extends "base.html.twig" %}

{% block tituloPagina %} <title>Noticia Ayto Cazorla</title> {% endblock %}


{% block formatoCss %}

    {{ parent() }}  {# Para dejar el css que tenía por defecto #}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <script src="js/script.js" defer></script>

{% endblock %}


{% block cuerpo %}

    <main class="main-noticia">
        <article class="articulo-contenedor">
            <header class="header-noticia">
                <h1> {{ noticia.titulo }} </h1>
                <div class="enlaces-redes">
                    <a href="#"> <img src="img/Social/TikTok.png" alt="Tiktok"> </a>
                    <a href="https://www.instagram.com/aytocazorla/?hl=es" target="_blank"> <img src="img/Social/IG.png" alt="Instragram"> </a>
                    <a href="https://x.com/AytodeCazorla" target="_blank"> <img src="img/Social/X.png" alt="Twitter"> </a>
                    <a href="noticia_imprimir.php"> <img src="img/Social/Print.png" alt="Imprimir"> </a>    
                </div>
            </header>

            <section class="cuerpo-noticia">
                <div class="texto-noticia">
                    {# raw se usa para que el navegador entienda que es HTML real y no simple texto #}
                    <p> {{ noticia.descripcion|raw }} </p>
                </div>
                <div class="imagenes-noticia">
                    {% for img in imagenes %}
                        <img src="{{ img.ruta }}" alt="Foto de la noticia">
                    {% endfor %}
                </div>
            </section>
        </article>
    </main>

    <div id="zona-derecha"></div>

    <div id="pestana-abrir">
            <i class="fa-solid fa-comments"></i>
    </div>

    <aside class="formulario">
        <button id="cancel">&times;</button>
        <button id="boton-bloque-formulario"> <i class="fa-solid fa-plus"></i> </button>
        
        <form class="bloque-formulario" >
            <label for="autor-comentario">Nombre:</label>
            <input type="text" name="nombre" class="input-estilo" id="autor-comentario">
            
            <label for="email-comentario">Correo:</label>
            <input type="email" name="email" class="input-estilo" id="email-comentario">

            <label for="texto-comentario">Texto:</label>
            <textarea name="text" class="input-estilo" id="texto-comentario" rows="6"></textarea>

            <div class="botones-comentario">
                <button type="button" id="cancelar-comentario">Cancelar</button>
                <button type="submit">Enviar</button>
            </div>
        </form>

        <ul class="comments">
            <li> 
                <div class="c-nombre"> Juan Carlos Ruiz </div> 
                <div class="c-hora"> hace 14 minutos | 22 mar. 2026 </div>
                <div class="c-comentario"> ¡Vaya susto! Justo pasé por ahí hace media hora y se veía el pino algo inclinado por el viento. Gracias al Ayuntamiento de Cazorla por avisar rápido, mejor dar la vuelta por la carretera de El Valle para no quedarse atrapado.</div>
            </li>
            <li> 
                <div class="c-nombre"> Elena M. Serrano </div> 
                <div class="c-hora"> 9:35 | 21/03/2026 </div>
                <div class="c-comentario"> ¿Se sabe cuánto tiempo va a estar cortada la vía? Tengo que subir a Arroyo Frío esta tarde por trabajo. Espero que los servicios de mantenimiento puedan retirarlo pronto, con estas rachas de viento está la sierra peligrosa.</div>
            </li>
            <li>
                <div class="c-nombre"> Sergio Estepa Gómez </div> 
                <div class="c-hora"> 21:12 | 20/03/2026 </div>
                <div class="c-comentario"> Precaución a todos los que suban por la zona del control. Es un pino de gran porte y ocupa los dos carriles. Menos mal que no ha pillado a ningún coche debajo. ¡Ánimo a los operarios que están allí con las motosierras!</div>
            </li>
        </ul>
    </aside>

{% endblock %}