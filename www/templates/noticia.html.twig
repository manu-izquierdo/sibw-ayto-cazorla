{% extends "base.html.twig" %}

{% block tituloPagina %} <title>Noticia Ayto Cazorla</title> {% endblock %}

{% block formatoCss %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
{% endblock %}

{% block cuerpo %}

    {# data-localidades pasa el array PHP a JS sin necesidad de <script> inline #}
    <main class="main-noticia" data-localidades="{{ lugares_js|json_encode }}">
        <article class="articulo-contenedor">
            <header class="header-noticia">
                <h1> {{ noticia.titulo }} </h1>
                <div class="enlaces-redes">
                    <a href="#"> <img src="img/Social/TikTok.png" alt="Tiktok"> </a>
                    <a href="https://www.instagram.com/aytocazorla/?hl=es" target="_blank"> <img src="img/Social/IG.png" alt="Instagram"> </a>
                    <a href="https://x.com/AytodeCazorla" target="_blank"> <img src="img/Social/X.png" alt="Twitter"> </a>
                    <a href="/imprimir/{{ noticia.id }}"> <img src="img/Social/Print.png" alt="Imprimir"> </a>
                </div>
            </header>

            {% if hashtags is not empty %}
                <div class="noticia-hashtags">
                    {% for tag in hashtags %}
                        <span class="hashtag-etiqueta">#{{ tag }}</span>
                    {% endfor %}
                </div>
            {% endif %}

            {# Barra de acciones para gestor/superusuario #}
            {% if sesion_rol in ['gestor', 'superusuario'] %}
                <div class="barra-gestion-noticia">
                    <a href="/noticias?accion=nueva" class="btn-gestion btn-gestion-nuevo">
                        <i class="fa-solid fa-plus"></i> Nueva noticia
                    </a>
                    <a href="/noticias?accion=form-editar&id={{ noticia.id }}" class="btn-gestion btn-gestion-editar">
                        <i class="fa-solid fa-pen"></i> Editar esta noticia
                    </a>
                    <form action="/noticias" method="POST" style="display:inline"
                          onsubmit="return confirm('¿Borrar esta noticia? Se eliminarán también sus imágenes y comentarios.');">
                        <input type="hidden" name="accion"     value="borrar">
                        <input type="hidden" name="id_noticia" value="{{ noticia.id }}">
                        <button type="submit" class="btn-gestion btn-gestion-borrar">
                            <i class="fa-solid fa-trash"></i> Borrar esta noticia
                        </button>
                    </form>
                </div>
            {% endif %}

            <section class="cuerpo-noticia">
                <div class="texto-noticia">
                    <p> {{ noticia.descripcion|raw }} </p>
                </div>
                <div class="imagenes-noticia">
                    {% for img in imagenes %}
                        <img src="{{ img.ruta }}" alt="Foto de la noticia">
                    {% endfor %}
                </div>
            </section>
        </article>
    </main>

    <div id="zona-derecha"></div>

    <div id="pestana-abrir">
        <i class="fa-solid fa-comments"></i>
    </div>

    <aside class="formulario">
        <button id="cancel">&times;</button>
        <button id="boton-bloque-formulario"> <i class="fa-solid fa-plus"></i> </button>

        {# Formulario de nuevo comentario: solo para usuarios logueados #}
        {% if sesion_id %}
            <form class="bloque-formulario" action="/noticia/{{ noticia.id }}" method="POST">
                <input type="hidden" name="noticia_id" value="{{ noticia.id }}">

                <label for="autor-comentario">Nombre:</label>
                <input type="text" name="nombre" class="input-estilo" id="autor-comentario" required>

                <label for="email-comentario">Correo:</label>
                <input type="email" name="email" class="input-estilo" id="email-comentario" required>

                <label for="texto-comentario">Texto:</label>
                <textarea name="texto" class="input-estilo" id="texto-comentario" rows="6" required></textarea>

                <div class="botones-comentario">
                    <button type="button" id="cancelar-comentario">Cancelar</button>
                    <button type="submit">Enviar</button>
                </div>
            </form>
        {% else %}
            <p class="aviso-login">
                <a href="/login">Inicia sesión</a> para dejar un comentario.
            </p>
        {% endif %}

        <ul class="comments">
            {% for comentario in comentarios %}
                <li>
                    <div class="c-cabecera">
                        <div>
                            <div class="c-nombre"> {{ comentario.nombre }} </div>
                            <div class="c-hora"> {{ comentario.fecha|date("H:i | d/m/Y") }} </div>
                        </div>

                        {# Iconos de moderación: solo para moderador y superusuario #}
                        {% if sesion_rol in ['moderador', 'superusuario'] %}
                            <div class="c-acciones-mod">

                                {# Botón editar: muestra/oculta formulario inline #}
                                <button class="btn-icono btn-editar-toggle"
                                        onclick="toggleEditarComentario({{ comentario.id }})"
                                        title="Editar">
                                    <i class="fa-solid fa-pen"></i>
                                </button>

                                {# Botón borrar #}
                                <form action="/comentarios" method="POST" style="display:inline"
                                      onsubmit="return confirm('¿Borrar este comentario?');">
                                    <input type="hidden" name="accion"        value="borrar">
                                    <input type="hidden" name="id_comentario" value="{{ comentario.id }}">
                                    <input type="hidden" name="noticia_id"    value="{{ noticia.id }}">
                                    <input type="hidden" name="origen"        value="noticia">
                                    <button type="submit" class="btn-icono btn-borrar" title="Borrar">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </form>
                            </div>
                        {% endif %}
                    </div>

                    {# Texto del comentario (modo lectura) #}
                    <div class="c-comentario" id="texto-{{ comentario.id }}">
                        {{ comentario.texto }}
                        {% if comentario.editado %}
                            <span class="badge-editado">Mensaje editado por el moderador</span>
                        {% endif %}
                    </div>

                    {# Formulario de edición inline (oculto por defecto) #}
                    {% if sesion_rol in ['moderador', 'superusuario'] %}
                        <form id="form-editar-{{ comentario.id }}"
                              action="/comentarios" method="POST"
                              class="form-editar-comentario" style="display:none;">
                            <input type="hidden" name="accion"        value="editar">
                            <input type="hidden" name="id_comentario" value="{{ comentario.id }}">
                            <input type="hidden" name="noticia_id"    value="{{ noticia.id }}">
                            <input type="hidden" name="origen"        value="noticia">
                            <textarea name="texto" class="input-estilo" rows="3" required>{{ comentario.texto }}</textarea>
                            <div class="acciones-editar">
                                <button type="submit" class="btn-auth btn-guardar-edicion">
                                    <i class="fa-solid fa-floppy-disk"></i> Guardar
                                </button>
                                <button type="button" class="btn-cancelar-edicion"
                                        onclick="toggleEditarComentario({{ comentario.id }})">
                                    Cancelar
                                </button>
                            </div>
                        </form>
                    {% endif %}
                </li>
            {% else %}
                <li><div class="c-comentario">No hay comentarios aún.</div></li>
            {% endfor %}
        </ul>
    </aside>

{% endblock %}