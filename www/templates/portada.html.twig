{% extends "base.html.twig" %}

{% block tituloPagina %} <title>Portada Ayto Cazorla</title> {% endblock %}

{% block cuerpo %}

    <main class="main-portada">
        {% for noticia in noticias %}
            <a href="noticia.php?id={{ noticia.id }}">
                <article>
                    <figure>
                        {# Si no hay imagen asociada, usamos una por defecto #}
                        <img src="{{ noticia.ruta|default('img/prueba.jpg') }}" alt="{{ noticia.titulo }}">
                        <figcaption> {{ noticia.titulo }} </figcaption>
                    </figure>   
                </article>
            </a>
        {% else %}
            <p>No hay noticias disponibles en este momento.</p>
        {% endfor %}
    </main>

{% endblock %}