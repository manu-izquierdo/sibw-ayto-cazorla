{# Se hereda lo de base.html y simplemente se rellenan los huecos #}
{% extends "base.html.twig" %}

{# Sobreescribe el valor del bloque tituloPagina por este #}
{% block tituloPagina %} <title>Portada Ayto Cazorla</title> {% endblock %}

{% block cuerpo %}
    <main class="main-portada">

        {# ── P5: Buscador dinámico estilo Google ── #}
        <div class="buscador-portada-wrapper">
            <input type="text" id="busqueda-portada"
                   placeholder="🔍 Buscar noticias..."
                   autocomplete="off">
            <div id="dropdown-portada" class="dropdown-busqueda"></div>
        </div>

        {% for noticia in noticias %}
            <a href="/noticia/{{ noticia.id }}">
                <article>
                    <figure>
                        <img src="{{ noticia.ruta|default('img/prueba.jpg') }}" alt="{{ noticia.titulo }}">
                        <figcaption> {{ noticia.titulo }} </figcaption>
                    </figure>
                </article>
            </a>
        {% else %}
            <p style="grid-column: 1/-1">No hay noticias publicadas en este momento.</p>
        {% endfor %}

    </main>
{% endblock %}